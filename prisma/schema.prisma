
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Bookmarks {
  id Int @id @default(autoincrement())
  title String 
  url String?
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}